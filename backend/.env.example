NODE_ENV=development
APP_PORT=3000

DATABASE_URL=postgresql://checkout_user:checkout_pass@localhost:5432/checkout_db

JWT_SECRET=super-secret-key-must-be-at-least-32-chars-long
JWT_EXPIRATION=24h

